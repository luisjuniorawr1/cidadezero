[Unit]
Description=Cidade Zero - motor persistente com autonomia
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/cidadezero
EnvironmentFile=/etc/cidade-zero.env
ExecStart=/opt/cidadezero/.venv/bin/uvicorn app.augmented:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
