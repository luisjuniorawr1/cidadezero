# Ritmo oficial: o relógio avança 1 minuto da cidade a cada 12 segundos reais.
# Isso mantém a proporção de 1 minuto real = 5 minutos na Cidade Zero.
# Portanto: 1 hora da cidade = 12 minutos reais; 1 dia = 4h48 reais.
CITY_MINUTES_PER_TICK=1
CITY_TICK_SECONDS=12
DATABASE_PATH=data/cidade_zero.db
ADMIN_TOKEN=troque-este-token
